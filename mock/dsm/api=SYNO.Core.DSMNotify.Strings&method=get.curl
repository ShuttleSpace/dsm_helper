{"data":{"ADServerDetectIPChanged":{"level":"NOTIFICATION_WARN","msg":"检测到 IP 地址更改。请检查 DNS Server 中的资源记录并重新启动 Synology Directory Server","title":"Synology Directory Server"},"AFPNotifyDeprecated":{"level":"NOTIFICATION_INFO","msg":"下一个主要 DSM 版本将不再支持 AFP。","title":"系统"},"APACHE_ALIAS_CONFLICT":{"level":"NOTIFICATION_WARN","msg":"Apache 2.4 配置中的冗余别名与 %PACKAGE% 套件冲突","title":"Web Station"},"AdvisorNotifyFinish":{"level":"NOTIFICATION_INFO","msg":"SSD 缓存建议分析完成。","title":"存储"},"AdvisorNotifyGetSuggestion":{"level":"NOTIFICATION_INFO","msg":"SSD 缓存建议生成了建议的缓存容量。","title":"存储"},"AdvisorNotifyLoadFail":{"level":"NOTIFICATION_ERROR","msg":"SSD 缓存建议无法加载。","title":"存储"},"AdvisorNotifyLoadFailNoSuggestion":{"level":"NOTIFICATION_ERROR","msg":"SSD 缓存建议无法加载并继续分析。","title":"存储"},"AdvisorNotifyLoadFailNotEnoughMem":{"level":"NOTIFICATION_ERROR","msg":"系统内存不足，SSD 缓存建议无法加载。","title":"存储"},"AdvisorNotifyTerminatedAbnormal":{"level":"NOTIFICATION_ERROR","msg":"SSD 缓存建议分析异常停止。请进入存储管理器 > 存储 > SSD 缓存建议，并检查生成的结果。如果数据使用模式仍在变化，您可以重新开始分析，并让其能有更长的运行时间以获得更合适的缓存容量。","title":"存储"},"AdvisorNotifyTerminatedAbnormalNoSuggestion":{"level":"NOTIFICATION_ERROR","msg":"SSD 缓存建议分析异常停止，且未生成结果。请进入存储管理器 > 存储 > SSD 缓存建议以重新开始分析。","title":"存储"},"AdvisorNotifyTerminatedVolCacheAbnormal":{"level":"NOTIFICATION_ERROR","msg":"由于存储空间或 SSD 缓存状态异常，SSD 缓存建议分析已停止。请进入存储管理器 > 存储 > SSD 缓存建议，并检查生成的结果。","title":"存储"},"AdvisorNotifyTerminatedVolCacheAbnormalNoSuggestion":{"level":"NOTIFICATION_ERROR","msg":"由于存储空间或 SSD 缓存状态异常，SSD 缓存建议分析已停止。请先解决问题，再重新开始分析。","title":"存储"},"AuthError":{"level":"NOTIFICATION_ERROR","msg":"%HOSTNAME% 上的 Synology Drive ShareSync 验证错误.","title":"Synology Drive ShareSync"},"AutoBlockAdd":{"level":"NOTIFICATION_INFO","msg":"%HOSTNAME% 已通过 %SERVICE% 封锁 IP 地址[%CLIENT_IP%]。","title":"系统"},"AutoBlockDatabaseRulesWarning":{"level":"NOTIFICATION_WARN","msg":"%HOSTNAME% 封锁列表中的 IP 地址太多。","title":"系统"},"BtrfsVolumeMetadataLow":{"level":"NOTIFICATION_WARN","msg":"%HOSTNAME% 上存储空间 %VOLUME_ID% 的元数据可用空间即将用尽。","title":"存储"},"BuildinSystemInodeFull":{"level":"NOTIFICATION_ERROR","msg":"%HOSTNAME% 系统分区中的文件数量将达到上限。","title":"系统"},"BuildinSystemVolumeFull":{"level":"NOTIFICATION_WARN","msg":"%HOSTNAME% 的系统存储容量即将用尽。","title":"存储"},"CMSClientConnectFailed":{"level":"NOTIFICATION_ERROR","msg":"%HOSTNAME% 无法连接到 CMS 主机 (%CMS_SERVER%)。","title":"系统"},"CMSClientDetachSuccess":{"level":"NOTIFICATION_INFO","msg":"%HOSTNAME% 已脱离 CMS 主机 (%CMS_SERVER%)。","title":"系统"},"CMSClientJoinSuccess":{"level":"NOTIFICATION_INFO","msg":"%HOSTNAME% 已加入 CMS 主机 (%CMS_SERVER%)。","title":"系统"},"CheckGroup_GroupRenamed":{"level":"NOTIFICATION_INFO","msg":"更新 %OSNAME% 时，已将群组“%OLD_NAME%”重命名为“%NEW_NAME%”。","title":"系统"},"CheckUser_UserRenamed":{"level":"NOTIFICATION_INFO","msg":"更新 %OSNAME% 时，已将用户“%OLD_NAME%”重命名为“%NEW_NAME%”。","title":"系统"},"ClientNeedToUpdate":{"level":"NOTIFICATION_INFO","msg":"%HOSTNAME% 上的 Synology Drive ShareSync 版本不是最新的.","title":"Synology Drive ShareSync"},"CpuFanResume":{"level":"NOTIFICATION_INFO","msg":"%HOSTNAME%（序列号：%HOST_SN%）上的 CPU 风扇 %FANID% 已恢复。","title":"系统"},"CpuFanStop":{"level":"NOTIFICATION_ERROR","msg":"%HOSTNAME%（序列号：%HOST_SN%）上的 CPU 风扇%FANID% 已停止工作。","title":"系统"},"DDNSFail":{"level":"NOTIFICATION_ERROR","msg":"无法通过 DDNS 服务将 IP 地址 %EXTERNAL_IP% 注册到 %DDNS_HOST_NAME%。","title":"系统"},"DLComplete":{"level":"NOTIFICATION_INFO","msg":"Download Station - %DLTYPE% 下载任务已完成","title":"Download Station"},"DSChange":{"level":"NOTIFICATION_INFO","msg":"%HOSTNAME% 上的 Synology Drive ShareSync 连接到不同服务器.","title":"Synology Drive ShareSync"},"DSMAutoUpdateCanceled":{"level":"NOTIFICATION_WARN","msg":"系统已取消 %HOSTNAME% 上的自动 %OSNAME% 更新。您仍可前往<a data-syno-app=\"SYNO.SDS.AdminCenter.Application\" data-syno-fn=\"SYNO.SDS.AdminCenter.Update_Reset.Main\">控制面板 &gt; 更新和还原</a>手动更新。","title":"系统"},"DSMAutoUpdateCanceledByUser":{"level":"NOTIFICATION_WARN","msg":"用户已取消 %HOSTNAME% 上的 %OSNAME% 自动更新。您仍可前往<a data-syno-app=\"SYNO.SDS.AdminCenter.Application\" data-syno-fn=\"SYNO.SDS.AdminCenter.Update_Reset.Main\">控制面板 &gt; 更新和还原</a>以手动更新。","title":"系统"},"DSMAutoUpdateDetectedCanDelay":{"level":"NOTIFICATION_ERROR","msg":"包含关键修复的新 %OSNAME% 版本现已推出。我们强烈建议尽快安装 %NEW_VERSION% 以确保数据安全。下次计划更新安装时间：%SCHEDULED_UPDATE_DATE%。如有需要，您可以%DELAY_LINK_START%延迟%DELAY_LINK_END%此更新。","title":"系统"},"DSMAutoUpdateFailed":{"level":"NOTIFICATION_ERROR","msg":"%HOSTNAME% 的 %OSNAME% 自动更新失败。请在<a data-syno-app=\"SYNO.SDS.AdminCenter.Application\" data-syno-fn=\"SYNO.SDS.AdminCenter.Update_Reset.Main\">%OSNAME% 更新</a>中检查状态。","title":"系统"},"DSMAutoUpdateNotifyNewImportantVersion":{"level":"NOTIFICATION_ERROR","msg":"已检测到 %HOSTNAME% 的重要 %OSNAME% 更新。","title":"系统"},"DSMAutoUpdateNotifyNewVersion":{"level":"NOTIFICATION_ERROR","msg":"检测到 %HOSTNAME% 上有新的 %OSNAME% 更新。","title":"系统"},"DSMAutoUpdateReady":{"level":"NOTIFICATION_INFO","msg":"%NEW_VERSION% 将于 %COUNTDOWN_MINUTE% 分钟后自动安装。单击<a  data-syno-scope=\"SYNO.SDS.DSMUpdateAction.Instance\" data-syno-func=\"SYNO.SDS.DSMUpdateAction.Instance.checkAutoUpdate\">此处</a>取消 %OSNAME% 当前的自动更新。","title":"系统"},"DSMAutoUpdateReadyCanCancel":{"level":"NOTIFICATION_ERROR","msg":"%NEW_VERSION% 将在 %COUNTDOWN_MINUTE% 分钟后自动安装。如有需要，您可以%DELAY_LINK_START%取消%DELAY_LINK_END%计划的 %OSNAME% 更新。","title":"系统"},"DSMAutoUpdateReadyCanDelay":{"level":"NOTIFICATION_ERROR","msg":"一项重要的 %OSNAME% 更新将在 10 分钟后自动安装。如有需要，您可以%DELAY_LINK_START%延期%DELAY_LINK_END%此更新。","title":"系统"},"DSMAutoUpdateReadyCantDelay":{"level":"NOTIFICATION_ERROR","msg":"更新将在 10 分钟后自动安装。","title":"系统"},"DSMAutoUpdateShutdownStart":{"level":"NOTIFICATION_INFO","msg":"计划关机前将在 %HOSTNAME% 上安装 %OSNAME% 更新。","title":"系统"},"DSMSupportFormCustomFailure":{"level":"NOTIFICATION_ERROR","msg":"%CUSTOM_MSG%。","title":"系统"},"DSMSupportFormCustomMessage":{"level":"NOTIFICATION_INFO","msg":"%CUSTOM_MSG%。","title":"系统"},"DSMUpdateAvailable":{"level":"NOTIFICATION_INFO","msg":"%OSNAME% 更新已准备好在 %HOSTNAME% 上安装。","title":"系统"},"DSMUpdateDownloadFailed":{"level":"NOTIFICATION_ERROR","msg":"%HOSTNAME% 的 %OSNAME% 更新补丁下载失败。请在<a data-syno-app=\"