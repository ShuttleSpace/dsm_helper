NOTIFICATION_WARN","msg":"%DISK_NAME% 的温度不在工作温度范围内。","title":"存储"},"DownloadCaptchaNeeded":{"level":"NOTIFICATION_WARN","msg":"[%HOSTNAME%] %DLTYPE% 下载任务需要 CAPTCHA 验证码","title":"Download Station"},"DownloadCompleted":{"level":"NOTIFICATION_INFO","msg":"[%HOSTNAME%] %DLTYPE% 下载任务 (%FILENAME%) 已完成","title":"Download Station"},"DownloadFailed":{"level":"NOTIFICATION_WARN","msg":"[%HOSTNAME%] %DLTYPE% 下载任务 (%FILENAME%) 失败","title":"Download Station"},"DriveInterfaceIncompatible":{"level":"NOTIFICATION_ERROR","msg":"检测到接口不兼容的硬盘。","title":"存储"},"DriveSlotDisabled":{"level":"NOTIFICATION_ERROR","msg":"硬盘插槽 %DISK_ID% 已禁用。","title":"存储"},"DsmProtectionCheckFailed":{"level":"NOTIFICATION_ERROR","msg":"系统检测到%HOSTNAME% 异常，已卸载所有存储空间。","title":"存储"},"DualControllerEboxFanResume":{"level":"NOTIFICATION_INFO","msg":"%HOSTNAME% 上 %CONTROLLOR_ID% 的 %EBOX_ID% 风扇%FAN_ID% 已恢复。","title":"外部存储"},"DualControllerEboxFanStop":{"level":"NOTIFICATION_ERROR","msg":"%HOSTNAME% 上 %CONTROLLOR_ID% 的 %EBOX_ID% 风扇%FAN_ID% 已停止工作。","title":"外部存储"},"ESATADiskFull":{"level":"NOTIFICATION_WARN","msg":"%HOSTNAME% 上的 eSATA 硬盘（硬盘 %DISK_NUMBER%）空间即将用完。","title":"外部存储"},"ESATAPartitionFull":{"level":"NOTIFICATION_WARN","msg":"%HOSTNAME% 上的 eSATA 硬盘（硬盘 %DISK_NUMBER%）的分区 %PARTITION_NUMBER% 空间即将用完。","title":"外部存储"},"EUnitPowerFail":{"level":"NOTIFICATION_ERROR","msg":"%HOSTNAME% 上 %EUNIT_ID% 的%POWERID% 号电源发生故障。","title":"外部存储"},"EUnitPowerResume":{"level":"NOTIFICATION_INFO","msg":"%HOSTNAME% 上 %EUNIT_ID% 的%POWERID% 号电源已恢复。","title":"外部存储"},"EboxFanResume":{"level":"NOTIFICATION_INFO","msg":"%HOSTNAME% 上的 %EBOX_ID% 风扇%FAN_ID% 已恢复。","title":"外部存储"},"EboxFanStop":{"level":"NOTIFICATION_ERROR","msg":"%HOSTNAME% 上的 %EBOX_ID% 风扇%FAN_ID% 已停止工作。","title":"外部存储"},"EboxLinkFail":{"level":"NOTIFICATION_ERROR","msg":"在%HOSTNAME%（序列号：%HOST_SN%）的扩充设备 %EBOX_ID% (SAS Out -%LINK_ID%) 上检测到接口连接不正确。","title":"外部存储"},"EboxLinkResume":{"level":"NOTIFICATION_INFO","msg":"在%HOSTNAME%（序列号：%HOST_SN%）的扩充设备 %EBOX_ID%(SAS Out -%LINK_ID%) 上检